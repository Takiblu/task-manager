<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Manjaro Task Manager</vendor>
  <vendor_url>https://github.com/Takiblu</vendor_url>
  <icon_name>manjaro-task-manager</icon_name>

  <!--
    This application never runs as root and never calls sudo directly
    (see project security requirements). The only privileged path is
    pkexec, gated through this single policy action, used exclusively
    for: starting/stopping/enabling/disabling a systemd service, and
    (rarely) raising a process's scheduling priority above the
    current user's default nice level. Every pkexec invocation still
    goes through the app's own argv-list-only, PID/unit-validated
    call path — this policy does not grant blanket root, only an
    authenticated prompt per action via polkit's own agent.
  -->
  <action id="org.manjarotaskmanager.systemctl">
    <description>Manage a systemd service</description>
    <message>Authentication is required to manage this system service</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/systemctl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
